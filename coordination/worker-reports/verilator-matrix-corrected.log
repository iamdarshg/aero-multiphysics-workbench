CONTROL MODULE  ctrl/mdriven.v  (genuinely double-driven register q)
------------------------------------------------------------------------------
module mdriven(input wire clk, input wire a, input wire b, output reg [7:0] q);
  always @(posedge clk) if (a) q <= q + 8'd1;
  always @(posedge clk) if (b) q <= q - 8'd1;
endmodule

